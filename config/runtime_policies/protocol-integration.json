    "output_tokens": 0,
    "context_percent": 0,
    "max_candidate_chars": 50000,
    "gate_prompt_file": "runtime_policies/prompts/coding-context-compaction.txt",
    "retry_prompt_file": "runtime_policies/prompts/coding-context-compaction-retry.txt"
