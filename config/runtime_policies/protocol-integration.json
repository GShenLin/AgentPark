{
  "schema_version": 1,
  "policy_id": "protocol-integration",
  "version": "1.0.0",
  "description": "Protocol integration policy for wire contracts, authentication, state transitions, compatibility failures, and boundary tests.",
  "task_direction": {
    "enabled": true,
    "required_tools": [
      "get_task_direction",
      "replace_task_direction",
      "update_task_direction"
    ],
    "analysis_tools": [],
