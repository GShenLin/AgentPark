[Unit]
Description=AgentPark authenticated STUN/TURN service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentpark
RuntimeDirectory=agentpark-turn
ExecStart=/usr/bin/turnserver -c /etc/agentpark/turnserver.conf --log-file=stdout --pidfile=/run/agentpark-turn/turnserver.pid
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
